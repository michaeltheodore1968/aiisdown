{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aiisdown",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": "./public" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aiisdown",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": true },
  "vars": {
    "SITE_URL": "https://aiisdown.com",
    "OPERATOR_NAME": "",
    "CONTACT_EMAIL": "",
    "ADSENSE_CLIENT": "",
    "ADSENSE_SLOT_TOP": "",
    "ADSENSE_SLOT_INLINE": ""
  }
}
