{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aiisdown",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": "./public" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aiisdown",
      "database_id": "bf4ba2f5-669c-48a2-96da-57b1c547cd88",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": true },
  "vars": {
    "SITE_URL": "https://aiisdown.com",
    "OPERATOR_NAME": "Michael Theodore",
    "OPERATOR_ADDRESS": "32 Main Road, Hextable, Swanley, Kent BR8 7RA",
    "CONTACT_EMAIL": "hello@aiisdown.com",
    "ADSENSE_CLIENT": "",
    "ADSENSE_SLOT_TOP": "",
    "ADSENSE_SLOT_INLINE": ""
  }
}
